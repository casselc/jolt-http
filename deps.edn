;; jolt-http — a Capra-style HTTP/1.1 server for jolt (Clojure on Chez Scheme).
;; An incremental HTTP/1.1 parser and Ring-shaped handler contract layered over
;; jolt-tcp's jolt.net-backed readiness reactor. Run tests with the reviewed
;; fork compiler and `-M:test`.
;;
;; jolt.net, reached transitively through jolt-tcp, declares the native socket
;; libraries it needs. They must NOT be redeclared at the HTTP layer.
{:paths ["src"]

 :deps {io.github.casselc/jolt-tcp
        {:git/url "https://github.com/casselc/jolt-tcp.git"
         :git/sha "911cf783d56e988adb2b8f716b6636fae5454e52"}}

 ;; jolt-hegel is test-time only (property/stateful generation via libhegel), so
 ;; it lives in :extra-deps rather than :deps. Pinned to the reviewed public
 ;; direct-libhegel branch commit. Because the dep is alias-scoped, the installer
 ;; needs the alias too:
 ;; `JOLT_CACHE_DIR=.jolt-cache/jolt-hegel-<sha> jolt -A:test -m hegel.install`
 ;; (the cache is keyed by the pinned SHA so another release cannot reuse its
 ;; compiled namespaces).
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.chucklehead-dev/jolt-hegel
                               {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                                :git/sha "c406e6a85e9902dd89a42a3abce3d6161e5cd406"}}
                  :main-opts ["-m" "jolt.http.server-test"]}

           ;; Checked-in mains avoid Jolt's currently POSIX-only stdin path on
           ;; native Windows while keeping each source-mode claim explicit.
           ;;
           ;; The runtime gate deliberately declares no :extra-deps. Real
           ;; Windows HTTP socket coverage must not be able to disappear because
           ;; an optional test dependency failed to resolve or install; the
           ;; Hegel-required suite is the separate :test lane.
           ;;
           ;; One alias serves both Windows architectures. The pinned jolt-tcp
           ;; revision reaches a jolt.net that ships reviewed Winsock readiness
           ;; for x86-64 and aarch64 alike, so the gate is selected by the
           ;; JOLT_EXPECTED_ARCH the runner declares, not by a separate lane.
           :windows-runtime-test
           {:extra-paths ["test"]
            :main-opts ["-m" "jolt.http.windows-runtime-test"]}}

 :tasks {test "jolt -M:test"}}
